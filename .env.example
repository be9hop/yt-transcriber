# Bind address/port for `uvicorn` (the Dockerfile CMD reads PORT).
HOST=0.0.0.0
PORT=8000

# Shared secret for /transcript and /info, passed as the X-API-Key header
# (query parameters are deliberately not accepted). Leave empty to disable
# auth — but always set this on any public deployment.
# API_KEY=change-me

# SQLite cache file. Defaults to /data/cache.sqlite3 when /data exists and is writable,
# otherwise ./cache.sqlite3 next to the code. Cache failures never fail a request.
# CACHE_DB_PATH=/data/cache.sqlite3

# Days a cached transcript stays fresh.
# CACHE_TTL_DAYS=30

# Token-bucket size per client IP per minute (0 disables rate limiting).
# RATE_LIMIT_PER_MINUTE=30

# Netscape-format cookie jar for YouTube bot-check bypass (see README).
# YOUTUBE_COOKIES_FILE=/data/cookies.txt

# Upstream socket timeout (seconds) passed to yt-dlp.
# REQUEST_TIMEOUT=60

# How many reverse proxies in front of the app append to X-Forwarded-For:
#   0 = ignore the header, rate-limit by socket peer (default; direct exposure)
#   1 = one proxy, e.g. Easypanel/Traefik only (Cloudflare in DNS-only mode)
#   2 = Cloudflare proxy (orange cloud) in front of Easypanel
# TRUST_PROXY_COUNT=0

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty to disable CORS entirely (no Access-Control headers emitted).
# Only needed when a browser app on another origin calls this API.
# CORS_ORIGINS=https://app.example.com
